{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rdpctl",
  "version": "0.1.0",
  "identifier": "io.github.jeeftor.rdpctl",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "rdpctl — Connections", "width": 960, "height": 680, "minWidth": 700, "minHeight": 520 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "targets": ["deb", "rpm"],
    "category": "Network",
    "shortDescription": "Saved connections for the portable FreeRDP client",
    "linux": {
      "deb": { "depends": ["freerdp-portable", "libwebkit2gtk-4.1-0", "libgtk-3-0"] },
      "rpm": { "depends": ["freerdp-portable", "webkit2gtk4.1", "gtk3"] }
    }
  }
}
